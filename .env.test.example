# Template for .env.test (gitignored). scripts/dev-env-up.ps1 copies it on first run and generates ENCRYPTION_KEY.
# Dev values only. Never commit real tokens.
POSTGRES_USER=openksef
POSTGRES_PASSWORD=openksef_dev_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
ENCRYPTION_KEY=

# Required for the image build: GitHub PAT (classic) with read:packages. See CONTRIBUTING.md.
NUGET_CIRFMF_PAT=

APP_EXTERNAL_BASE_URL=http://localhost:8080
KSEF_BASE_URL=test

E2E_TEST_USER=testuser
E2E_TEST_PASSWORD=Test1234!

# Optional: KSeF TEST company. Without both values test data provisioning is skipped.
E2E_TEST_NIP=
E2E_TEST_KSEF_TOKEN=

# Optional: second KSeF TEST company for testuser. Without both values it is skipped.
KSEF_TEST_NIP_2=
KSEF_TEST_TOKEN_2=
