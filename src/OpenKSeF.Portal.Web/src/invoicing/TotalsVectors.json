[
  {
    "name": "per-rate VAT, not per-line: 3 x 0.33 @23",
    "lines": [
      { "quantity": 1, "unitNetPrice": 0.33, "vatRate": "23" },
      { "quantity": 1, "unitNetPrice": 0.33, "vatRate": "23" },
      { "quantity": 1, "unitNetPrice": 0.33, "vatRate": "23" }
    ],
    "expected": {
      "lineNet": [0.33, 0.33, 0.33],
      "vatSummary": [{ "vatRate": "23", "net": 0.99, "vat": 0.23 }],
      "totalNet": 0.99,
      "totalVat": 0.23,
      "totalGross": 1.22
    }
  },
  {
    "name": "two rates: 100 @23 + 100 @8",
    "lines": [
      { "quantity": 1, "unitNetPrice": 100, "vatRate": "23" },
      { "quantity": 1, "unitNetPrice": 100, "vatRate": "8" }
    ],
    "expected": {
      "lineNet": [100, 100],
      "vatSummary": [
        { "vatRate": "23", "net": 100, "vat": 23 },
        { "vatRate": "8", "net": 100, "vat": 8 }
      ],
      "totalNet": 200,
      "totalVat": 31,
      "totalGross": 231
    }
  },
  {
    "name": "0 KR has no VAT",
