    "expected": {
      "lineNet": [50],
      "vatSummary": [{ "vatRate": "0 KR", "net": 50, "vat": 0 }],
      "totalNet": 50,
      "totalVat": 0,
      "totalGross": 50
    }
  },
  {
    "name": "zw has no VAT",
    "lines": [{ "quantity": 2, "unitNetPrice": 120, "vatRate": "zw" }],
    "expected": {
      "lineNet": [240],
      "vatSummary": [{ "vatRate": "zw", "net": 240, "vat": 0 }],
      "totalNet": 240,
      "totalVat": 0,
      "totalGross": 240
    }
  },
  {
    "name": "half away from zero on line net and VAT: 1.5 x 0.33 @23",
    "lines": [{ "quantity": 1.5, "unitNetPrice": 0.33, "vatRate": "23" }],
    "expected": {
      "lineNet": [0.5],
      "vatSummary": [{ "vatRate": "23", "net": 0.5, "vat": 0.12 }],
      "totalNet": 0.5,
      "totalVat": 0.12,
      "totalGross": 0.62
    }
  },
  {
